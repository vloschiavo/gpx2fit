<?xml version="1.0" encoding="UTF-8"?>
<!-- Three legs stored out of order: Tail, Middle, Head (Head is written
     backwards). With the "Start" waypoint the stitched course must be
     Head(reversed), Middle, Tail. -->
<gpx version="1.1" creator="test" xmlns="http://www.topografix.com/GPX/1/1">
  <wpt lat="0.0" lon="0.0"><name>Start</name></wpt>
  <wpt lat="0.0" lon="0.04"><name>Water</name></wpt>
  <wpt lat="0.0" lon="0.08"><name>Camp</name></wpt>
  <trk>
    <name>Tail</name>
    <trkseg>
      <trkpt lat="0.0" lon="0.06"><ele>6</ele></trkpt>
      <trkpt lat="0.0" lon="0.07"><ele>7</ele></trkpt>
      <trkpt lat="0.0" lon="0.08"><ele>8</ele></trkpt>
    </trkseg>
  </trk>
  <trk>
    <name>Middle</name>
    <trkseg>
      <trkpt lat="0.0" lon="0.03"><ele>3</ele></trkpt>
      <trkpt lat="0.0" lon="0.04"><ele>4</ele></trkpt>
      <trkpt lat="0.0" lon="0.05"><ele>5</ele></trkpt>
    </trkseg>
  </trk>
  <trk>
    <name>Head</name>
    <trkseg>
      <trkpt lat="0.0" lon="0.02"><ele>2</ele></trkpt>
      <trkpt lat="0.0" lon="0.01"><ele>1</ele></trkpt>
      <trkpt lat="0.0" lon="0.00"><ele>0</ele></trkpt>
    </trkseg>
  </trk>
</gpx>
